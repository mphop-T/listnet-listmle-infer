{
  "model": {
    "fc_model": {
      "sizes": [64, 128, 256, 128, 64],
      "input_norm": true,
      "activation": "ReLU",
      "dropout": 0.2
    },
    "transformer": null,
    "post_model": {
      "output_activation": null,
      "d_output": 1
    }
  },
  "data": {
    "path": "/allrank/athletes_women_data_combined",
